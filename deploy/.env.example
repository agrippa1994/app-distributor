# Image tag pushed by GitHub Actions: short commit sha (sha-abc1234) or a release (1.2.3)
APP_DISTRIBUTOR_TAG=sha-abc1234

# Public hostname; needs a DNS record pointing at this host. iOS installs require HTTPS.
APP_DISTRIBUTOR_DOMAIN=apps.example.com

# Signs session cookies and install links. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Keep at most N versions per app (oldest are deleted on upload). 0 = keep all.
KEEP_VERSIONS=0
